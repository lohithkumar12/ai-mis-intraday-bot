# =============================================================================
# AI MIS Intraday Bot — same architecture as New_StartUp (CNC), MIS defaults
# SAFE: paper INR + live NSE quotes. Real money only with double live flags.
# CNC bot is separate; this MIS sleeve is capped by INDIA_CAPITAL_CAP.
# =============================================================================

# --- India broker: dhan (default) | angel ---
INDIA_BROKER=dhan

# DhanHQ
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_dhan_totp_secret
DHAN_API_KEY=your_dhan_api_key
DHAN_API_SECRET=your_dhan_api_secret

# Paper sim: live NSE data, fake INR (no real orders)
INDIA_PAPER=true
INDIA_PAPER_STARTING_CASH=150000

# MIS / INTRADAY only (do not set CNC on this project)
INDIA_PRODUCT_TYPE=INTRADAY

# Soft buying-power sleeve for sizing + daily DD (even if Dhan equity is higher)
INDIA_CAPITAL_CAP=150000

# Real INR MIS orders ONLY when BOTH are set:
LIVE_TRADING=false
LIVE_CONFIRM=

# Core loop scans ONLY INDIA_STOCK_UNIVERSE (scout is optional).
# Single ~50-name universe (no scout): uncomment the full list and set INDIA_SCOUT_ENABLED=false.
# INDIA_STOCK_UNIVERSE=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,HINDUNILVR,ITC,SBIN,BHARTIARTL,LT,KOTAKBANK,WIPRO,AXISBANK,BAJFINANCE,MARUTI,SUNPHARMA,TITAN,ASIANPAINT,ULTRACEMCO,NESTLEIND,POWERGRID,NTPC,ONGC,TATAMOTORS,TATASTEEL,JSWSTEEL,M&M,TECHM,HCLTECH,ADANIENT,ADANIPORTS,COALINDIA,BPCL,CIPLA,DRREDDY,APOLLOHOSP,EICHERMOT,HEROMOTOCO,INDUSINDBK,BAJAJFINSV,BAJAJ-AUTO,BRITANNIA,GRASIM,HINDALCO,DIVISLAB,HDFCLIFE,SBILIFE,TATACONSUM,BEL,TRENT

# =============================================================================
# Strategy — mis_regime (India default). Aliases: regime_mis, vwap_regime
# XOR: at most one playbook BUY per symbol per cycle. Completed 5m bars only.
# Legacy names still work: opening_range_breakout, trend_pullback, mean_reversion,
# regime_adaptive, breakout.
# =============================================================================
STRATEGY_NAME=mis_regime
TIMEFRAME=5
LOOKBACK_BARS=120
OR_MINUTES=15
CONFIRM_BARS=1
VOLUME_MULT=0.8
ORB_USE_HTF_FILTER=true
ORB_HTF_EMA_PERIOD=20
ORB_ALLOW_SHORT=false
USE_RELATIVE_STRENGTH=false
USE_MTF_FILTER=false
USE_REGIME_FILTER=false

# mis_regime knobs (do not change legacy ORB defaults above)
ORB_WINDOW_MINUTES=60
ADX_RISING_LOOKBACK=2
RANGE_EXPANSION_MULT=1.2
MIS_REGIME_CONFIRM_BARS=2
MIS_REGIME_VOLUME_MULT=1.2
MOMENTUM_LOOKBACK_BARS=20
EMA_EXTENSION_ATR=1.0
VWAP_STRETCH_ATR=1.0
RSI_OVERSOLD=30
VWAP_RECLAIM_BARS=1
LOSS_REENTRY_COOLDOWN_MIN=30
RS_TOP_N=5
RS_LOOKBACK_BARS=60

ATR_PERIOD=14
ADX_PERIOD=14
ADX_RANGE_MAX=25
VOLUME_AVG_PERIOD=20
STRICT_SELL=true

# =============================================================================
# Risk — MIS sleeve ~₹1.5L
# =============================================================================
RISK_PER_TRADE=0.006
MAX_POSITION_PCT=0.12
ATR_STOP_MULT=1.2
ATR_TRAIL_MULT=1.2
TAKE_PROFIT_R=1.25
STOP_LOSS_PCT=0.006
TAKE_PROFIT_PCT=0.009
DAILY_DRAWDOWN_LIMIT=0.02
DAILY_FLATTEN_ON_KILL=true
MAX_SHARES_PER_ORDER=500
MAX_OPEN_POSITIONS=2
MAX_CLUSTER_POSITIONS=2

# Session — no new MIS after ENTRY_CUTOFF; square-off from SQUAREOFF_TIME
# Keep square-off BEFORE broker RMS (~15:15). Do NOT redeploy mid-session while open.
AVOID_OPEN_MINUTES=15
AVOID_CLOSE_MINUTES=75
ALLOW_OPEN_CLOSE_WINDOW=false
ENTRY_CUTOFF=14:15
SQUAREOFF_TIME=15:00
# 0 = unlimited (off). Set a positive integer later if you want a hard cap.
MAX_TRADES_PER_DAY=0
# Optional absolute ₹ hard stop (0=off); daily DD% still applies
MAX_DAILY_LOSS_INR=0
COST_FLOOR_ENABLED=true
COST_FLOOR_RT_PCT=0.0005
COST_FLOOR_MIN_EDGE_BPS=5
FLATTEN_API_GAP_SEC=1.5
FLATTEN_RATE_LIMIT_BACKOFF_SEC=8

ALLOW_MARKET_ENTRIES=false
SYNC_BROKER_STOPS=true

BUY_REJECT_COOLDOWN_SEC=120
BUY_PENDING_COOLDOWN_SEC=90
ORDER_CONFIRM_TIMEOUT_SEC=8

TRADE_JOURNAL_PATH=trade_journal.db
# 5-min ORB: 60s is enough for ~50 names. A 20s loop is not required.
INDIA_LOOP_INTERVAL_SEC=60
# Pause between core-loop candle fetches (avoid HTTP 429 on ~50 names). 0=off.
INDIA_LOOP_FETCH_GAP_SEC=0.4

# Scout is optional. false = single universe (core INDIA_STOCK_UNIVERSE only).
# KEEP auto-buy OFF unless you explicitly want scout fills.
INDIA_SCOUT_ENABLED=false
INDIA_SCOUT_INTERVAL_SEC=300
INDIA_SCOUT_TOP_N=10
INDIA_SCOUT_MIN_SCORE=35
INDIA_SCOUT_AUTO_BUY=false
INDIA_SCOUT_RS_TOP_N=10
INDIA_SCOUT_FETCH_GAP_SEC=0.4

# Segments OFF for this MIS bot
INDIA_FNO_ENABLED=false
MCX_ENABLED=false
CURRENCY_ENABLED=false
US_ENABLED=false

# Optional alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

DHAN_LIVE_WEBSOCKET=true
