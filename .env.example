# =============================================================================
# AI MIS Intraday Bot — same architecture as New_StartUp (CNC), MIS defaults
# SAFE: paper INR + live NSE quotes. Real money only with double live flags.
# =============================================================================

# --- India broker: dhan (default) | angel ---
INDIA_BROKER=dhan

# DhanHQ
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_API_KEY=
DHAN_API_SECRET=

INDIA_PAPER=false
INDIA_PAPER_STARTING_CASH=150000

INDIA_PRODUCT_TYPE=INTRADAY

# Soft buying-power sleeve for sizing + daily DD (even if Dhan equity is higher)
INDIA_CAPITAL_CAP=300000

# Real INR MIS orders — ARMED (double flag)
LIVE_TRADING=true
LIVE_CONFIRM=YES_REAL_MONEY

# Single ~50 universe (no scout). Unique names from india_scout.DEFAULT_INDIA_SCOUT_UNIVERSE
INDIA_STOCK_UNIVERSE=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,HINDUNILVR,ITC,SBIN,BHARTIARTL,LT,KOTAKBANK,WIPRO,AXISBANK,BAJFINANCE,MARUTI,SUNPHARMA,TITAN,ASIANPAINT,ULTRACEMCO,NESTLEIND,POWERGRID,NTPC,ONGC,TATAMOTORS,TATASTEEL,JSWSTEEL,M&M,TECHM,HCLTECH,ADANIENT,ADANIPORTS,COALINDIA,BPCL,CIPLA,DRREDDY,APOLLOHOSP,EICHERMOT,HEROMOTOCO,INDUSINDBK,BAJAJFINSV,BAJAJ-AUTO,BRITANNIA,GRASIM,HINDALCO,DIVISLAB,HDFCLIFE,SBILIFE,TATACONSUM,BEL,TRENT

STRATEGY_NAME=mis_regime
TIMEFRAME=5
LOOKBACK_BARS=120
OR_MINUTES=15

# =============================================================================
# FILTERS — ENABLED (was false)
# =============================================================================
USE_REGIME_FILTER=true          # default: strict regime→playbook; false = kitchen-sink all playbooks
USE_MARKET_SMA_FILTER=false     # off: do not block all buys when RELIANCE < SMA200
USE_RELATIVE_STRENGTH=true      # CHANGED: true
USE_MTF_FILTER=true             # CHANGED: true

# =============================================================================
# SIGNAL QUALITY — INCREASED THRESHOLDS
# =============================================================================
CONFIRM_BARS=2                  # CHANGED: 2 (was 1)
VWAP_STRETCH_ATR=1.5            # CHANGED: 1.5 (was 1.0)
EMA_EXTENSION_ATR=1.5           # CHANGED: 1.5 (was 1.0)
MIS_REGIME_VOLUME_MULT=1.2      # Keep as-is
ORB_USE_HTF_FILTER=true
ORB_HTF_EMA_PERIOD=20
ORB_ALLOW_SHORT=false
ORB_WINDOW_MINUTES=60
ADX_RISING_LOOKBACK=2
RANGE_EXPANSION_MULT=1.2
MOMENTUM_LOOKBACK_BARS=20
RSI_OVERSOLD=30
VWAP_RECLAIM_BARS=1
LOSS_REENTRY_COOLDOWN_MIN=30
RS_TOP_N=10
RS_LOOKBACK_BARS=60

ATR_PERIOD=14
ADX_PERIOD=14
ADX_RANGE_MAX=25
VOLUME_AVG_PERIOD=20
STRICT_SELL=true

# =============================================================================
# RISK — ATR-ONLY (fixed % removed)
# =============================================================================
# Two-slot MIS preset: RISK_PER_TRADE = MAX_POSITION_PCT * MIN_STOP_PCT
# (2.50 * 0.0045 = 0.01125) so a 0.45%-stop trade uses ~half the 5x sleeve.
# Two concurrent names fit; full-5x one-name was MAX_POSITION_PCT=5.00 / RISK=0.0225.
RISK_PER_TRADE=0.01125
MAX_POSITION_PCT=2.50          # notional ceiling (~2.5x of sleeve per name)
MIN_STOP_PCT=0.0045            # min SL distance (0.45%); 0 = off
# Revert to old behaviour: RISK_PER_TRADE=0.008, MAX_POSITION_PCT=1.00,
# MIN_STOP_PCT=0, MAX_SHARES_PER_ORDER=500
ATR_STOP_MULT=1.5
ATR_TRAIL_MULT=0.75            # tighter than entry stop so a 1R spike keeps profit
MIN_TRAIL_PCT=0.0020           # 0.20% of peak; independent of MIN_STOP_PCT
TAKE_PROFIT_R=1.75             # Keep as-is
# STOP_LOSS_PCT=0.006          # DELETED
# TAKE_PROFIT_PCT=0.009        # DELETED
DAILY_DRAWDOWN_LIMIT=0.05
DAILY_FLATTEN_ON_KILL=true
MAX_SHARES_PER_ORDER=6000      # 6000*250 = 15L, so cap does not block 5x on names >= ~250
MAX_OPEN_POSITIONS=2
MAX_CLUSTER_POSITIONS=2
MAX_TRADES_PER_DAY=8           # CHANGED: 8 (was 0)
MAX_DAILY_LOSS_INR=15000

# =============================================================================
# SESSION — KEEP SQUAREOFF AT 15:00 (SAFER)
# =============================================================================
AVOID_OPEN_MINUTES=0
AVOID_CLOSE_MINUTES=45
ALLOW_OPEN_CLOSE_WINDOW=false
ENTRY_CUTOFF=14:15
SQUAREOFF_TIME=14:55           # Flatten before 15:00 liquidity drop / RMS ~15:15

ALLOW_MARKET_ENTRIES=false
SYNC_BROKER_STOPS=true
SYNC_BROKER_STOP_RETRIES=3
CIRCUIT_PROXIMITY_PCT=0.0005

BUY_REJECT_COOLDOWN_SEC=120
BUY_PENDING_COOLDOWN_SEC=90
ORDER_CONFIRM_TIMEOUT_SEC=8

TRADE_JOURNAL_PATH=trade_journal.db
INDIA_LOOP_INTERVAL_SEC=30
INDIA_LOOP_FETCH_GAP_SEC=0.4
INDIA_RISK_CHECK_INTERVAL_SEC=3
DASH_SSE_POS_REFRESH_SEC=5

# Scout off
INDIA_SCOUT_ENABLED=false
INDIA_SCOUT_INTERVAL_SEC=300
INDIA_SCOUT_TOP_N=10
INDIA_SCOUT_MIN_SCORE=45
INDIA_SCOUT_AUTO_BUY=false
INDIA_SCOUT_RS_TOP_N=10
INDIA_SCOUT_FETCH_GAP_SEC=0.4

# Segments — PAPER only
INDIA_FNO_ENABLED=false

MCX_ENABLED=true
MCX_PAPER=true
MCX_LIVE_TRADING=false
MCX_LIVE_CONFIRM=
MCX_CAPITAL_CAP=50000
MCX_UNIVERSE=CRUDEOIL,GOLD

CURRENCY_ENABLED=false

# Cheap/liquid sleeve for ~$500 (whole shares). India filters stay strict.
DHAN_LIVE_WEBSOCKET=true

# Second ORB after day-fired: +0.5% above prior 5m high AND volume > first ORB candle
ORB_CONTINUATION_ENABLED=true
ORB_CONTINUATION_BREAK_PCT=0.005
ORB_CONTINUATION_MAX=2

# Nifty/BankNifty 5m dump lock (blocks new BUYs only; does not flatten)
TIDE_FILTER_ENABLED=true
TIDE_TRIGGER_PCT=-0.65
TIDE_CLEAR_PCT=-0.20
# Startup/orphan MIS: local SL/TP when Dhan has a position but sl_tp_meta does not
ZOMBIE_SL_PCT=0.0045
ZOMBIE_TP_PCT=0.008
